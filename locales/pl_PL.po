msgid ""
msgstr ""
"Project-Id-Version: GLPI plugin pdf2text 1.0.0\n"
"Language: pl_PL\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=3; plural=(n==1 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2);\n"

msgid "Run \"composer install --no-dev\" in the plugin directory first."
msgstr "Najpierw uruchom „composer install --no-dev” w katalogu wtyczki."

#, php-format
msgid "Text of the PDF attachment \"%s\""
msgstr "Tekst załącznika PDF „%s”"

msgid "The text was shortened. The complete text is in the attachment."
msgstr "Tekst został skrócony. Pełny tekst znajduje się w załączniku."

msgid "The configuration was saved."
msgstr "Konfiguracja została zapisana."

msgid "PDF2Text"
msgstr "PDF2Text"

msgid "PDF2Text – configuration"
msgstr "PDF2Text – konfiguracja"

msgid "Add the text to"
msgstr "Dodawaj tekst do"

msgid "Private followup (only visible to technicians)"
msgstr "Prywatne dalsze działanie (widoczne tylko dla techników)"

msgid "Maximum length of the text (characters)"
msgstr "Maksymalna długość tekstu (znaki)"

msgid "Path of pdftotext (optional)"
msgstr "Ścieżka do pdftotext (opcjonalnie)"

msgid "Leave empty to search the usual places. Without pdftotext (package poppler-utils), the built-in PHP parser is used; pdftotext keeps tables and columns better."
msgstr "Pozostaw puste, aby szukać w typowych lokalizacjach. Bez pdftotext (pakiet poppler-utils) używany jest wbudowany parser PHP; pdftotext lepiej zachowuje tabele i kolumny."

msgid "Method in use"
msgstr "Używana metoda"

msgid "When a PDF, Word (DOCX) or OpenDocument (ODT) file is attached to a ticket, change or problem (by mail, form or API), its text is added as a followup, so it can be read and searched without opening the file. A file attached again to the same ticket adds no second followup. Scanned PDFs without a text layer are skipped."
msgstr "Gdy do zgłoszenia, zmiany lub problemu zostanie dołączony plik PDF, Word (DOCX) lub OpenDocument (ODT) (e-mailem, przez formularz lub API), jego tekst jest dodawany jako dalsze działanie, dzięki czemu można go czytać i przeszukiwać bez otwierania pliku. Plik ponownie dołączony do tego samego zgłoszenia nie tworzy drugiego dalszego działania. Zeskanowane pliki PDF bez warstwy tekstowej są pomijane."

msgid "Read these file types"
msgstr "Odczytuj te typy plików"

msgid "Word (DOCX)"
msgstr "Word (DOCX)"

msgid "OpenDocument text (ODT)"
msgstr "Tekst OpenDocument (ODT)"

msgid "Word and OpenDocument files need the PHP extensions zip and dom, which are missing on this server."
msgstr "Pliki Word i OpenDocument wymagają rozszerzeń PHP zip i dom, których brakuje na tym serwerze."

msgid "Files attached before"
msgstr "Wcześniej dołączone pliki"

msgid "Files attached before the plugin was enabled are not read automatically. To add their text, choose the tickets, changes or problems in their list and use the action \"Copy the text of the attachments (PDF2Text)\", or run on the server:"
msgstr "Pliki dołączone przed włączeniem wtyczki nie są odczytywane automatycznie. Aby dodać ich tekst, zaznacz zgłoszenia, zmiany lub problemy na ich liście i użyj akcji „Skopiuj tekst załączników (PDF2Text)” albo uruchom na serwerze:"

msgid "Files read before are skipped, so this can be repeated at any time."
msgstr "Pliki odczytane wcześniej są pomijane, więc można to powtarzać w dowolnym momencie."

#, php-format
msgid "Text of the attachment \"%s\""
msgstr "Tekst załącznika „%s”"

msgid "Copy the text of the attachments (PDF2Text)"
msgstr "Skopiuj tekst załączników (PDF2Text)"

msgid "The text of PDF, Word and OpenDocument attachments that were not read yet is added as a followup."
msgstr "Tekst jeszcze nieodczytanych załączników PDF, Word i OpenDocument jest dodawany jako dalsze działanie."

msgid "Copy the text into a followup (PDF2Text)"
msgstr "Skopiuj tekst do dalszego działania (PDF2Text)"

msgid "Add again"
msgstr "Dodaj ponownie"

msgid "The request failed. Please reload the page and try again."
msgstr "Żądanie nie powiodło się. Odśwież stronę i spróbuj ponownie."

msgid "PDF2Text is switched off for this type."
msgstr "PDF2Text jest wyłączony dla tego typu."

msgid "You may not add a followup here."
msgstr "Nie możesz tu dodać dalszego działania."

msgid "The file was not found."
msgstr "Nie znaleziono pliku."

msgid "The text of this file was added before. Add it again?"
msgstr "Tekst tego pliku został już dodany. Dodać go ponownie?"

msgid "The file contains no text (e.g. a scanned PDF)."
msgstr "Plik nie zawiera tekstu (np. zeskanowany PDF)."

msgid "This file type is not read (see the settings of PDF2Text)."
msgstr "Ten typ pliku nie jest odczytywany (zob. ustawienia PDF2Text)."

msgid "The file could not be read (see files/_log/pdf2text.log)."
msgstr "Nie udało się odczytać pliku (zob. files/_log/pdf2text.log)."

msgid "The text was added as a followup."
msgstr "Tekst został dodany jako dalsze działanie."

#, php-format
msgid "%d followup added"
msgid_plural "%d followups added"
msgstr[0] "%d dalsze działanie dodane"
msgstr[1] "%d dalsze działania dodane"
msgstr[2] "%d dalszych działań dodanych"

#, php-format
msgid "%d file was copied before"
msgid_plural "%d files were copied before"
msgstr[0] "%d plik był już wcześniej skopiowany"
msgstr[1] "%d pliki były już wcześniej skopiowane"
msgstr[2] "%d plików było już wcześniej skopiowanych"

#, php-format
msgid "%d file without text"
msgid_plural "%d files without text"
msgstr[0] "%d plik bez tekstu"
msgstr[1] "%d pliki bez tekstu"
msgstr[2] "%d plików bez tekstu"

#, php-format
msgid "%d file could not be read (see files/_log/pdf2text.log)"
msgid_plural "%d files could not be read (see files/_log/pdf2text.log)"
msgstr[0] "%d pliku nie udało się odczytać (zob. files/_log/pdf2text.log)"
msgstr[1] "%d plików nie udało się odczytać (zob. files/_log/pdf2text.log)"
msgstr[2] "%d plików nie udało się odczytać (zob. files/_log/pdf2text.log)"

msgid "no attachments with text"
msgstr "brak załączników z tekstem"

msgid "The text of this file was added before."
msgstr "Tekst tego pliku został już dodany."
