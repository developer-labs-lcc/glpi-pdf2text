msgstr "PDF2Text is switched off for this type."

msgid "You may not add a followup here."
msgstr "You may not add a followup here."

msgid "The file was not found."
msgstr "The file was not found."

msgid "The text of this file was added before. Add it again?"
msgstr "The text of this file was added before. Add it again?"

msgid "The file contains no text (e.g. a scanned PDF)."
msgstr "The file contains no text (e.g. a scanned PDF)."

msgid "This file type is not read (see the settings of PDF2Text)."
msgstr "This file type is not read (see the settings of PDF2Text)."

