msgid ""
msgstr ""
"Project-Id-Version: GLPI plugin pdf2text 1.0.0\n"
"Language: de_DE\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "Run \"composer install --no-dev\" in the plugin directory first."
msgstr "Bitte zuerst im Plugin-Verzeichnis \"composer install --no-dev\" ausführen."

#, php-format
msgid "Text of the PDF attachment \"%s\""
msgstr "Text des PDF-Anhangs „%s“"

msgid "The text was shortened. The complete text is in the attachment."
msgstr "Der Text wurde gekürzt. Der vollständige Text steht im Anhang."

msgid "The configuration was saved."
msgstr "Die Konfiguration wurde gespeichert."

msgid "PDF2Text"
msgstr "PDF2Text"

msgid "PDF2Text – configuration"
msgstr "PDF2Text – Konfiguration"

msgid "Add the text to"
msgstr "Text hinzufügen bei"

msgid "Private followup (only visible to technicians)"
msgstr "Privater Folgebeitrag (nur für Techniker sichtbar)"

msgid "Maximum length of the text (characters)"
msgstr "Maximale Länge des Textes (Zeichen)"

msgid "Path of pdftotext (optional)"
msgstr "Pfad zu pdftotext (optional)"

msgid "Leave empty to search the usual places. Without pdftotext (package poppler-utils), the built-in PHP parser is used; pdftotext keeps tables and columns better."
msgstr "Leer lassen, um die üblichen Orte zu durchsuchen. Ohne pdftotext (Paket poppler-utils) wird der eingebaute PHP-Parser verwendet; pdftotext erhält Tabellen und Spalten besser."

msgid "Method in use"
msgstr "Verwendete Methode"

msgid "When a PDF, Word (DOCX) or OpenDocument (ODT) file is attached to a ticket, change or problem (by mail, form or API), its text is added as a followup, so it can be read and searched without opening the file. A file attached again to the same ticket adds no second followup. Scanned PDFs without a text layer are skipped."
msgstr "Wird an ein Ticket, einen Change oder ein Problem ein PDF, ein Word-Dokument (DOCX) oder ein OpenDocument-Text (ODT) angehängt (per Mail, Formular oder API), wird sein Text als Folgebeitrag hinzugefügt. So lässt er sich lesen und durchsuchen, ohne die Datei zu öffnen. Wird dieselbe Datei erneut an dasselbe Ticket angehängt, entsteht kein zweiter Folgebeitrag. Gescannte PDFs ohne Textebene werden übersprungen."

msgid "Read these file types"
msgstr "Diese Dateitypen lesen"

msgid "Word (DOCX)"
msgstr "Word (DOCX)"

msgid "OpenDocument text (ODT)"
msgstr "OpenDocument-Text (ODT)"

msgid "Word and OpenDocument files need the PHP extensions zip and xmlreader, which are missing on this server."
msgstr "Word- und OpenDocument-Dateien brauchen die PHP-Erweiterungen zip und xmlreader, die auf diesem Server fehlen."

msgid "Files attached before"
msgstr "Früher angehängte Dateien"

msgid "Files attached before the plugin was enabled are not read automatically. To add their text, choose the tickets, changes or problems in their list and use the action \"Copy the text of the attachments (PDF2Text)\", or run on the server:"
msgstr "Dateien, die vor dem Aktivieren des Plugins angehängt wurden, werden nicht automatisch gelesen. Um ihren Text hinzuzufügen, in der Liste der Tickets, Changes oder Problems die gewünschten auswählen und die Aktion „Text der Anhänge übernehmen (PDF2Text)“ nutzen, oder auf dem Server ausführen:"

msgid "Files read before are skipped, so this can be repeated at any time."
msgstr "Bereits gelesene Dateien werden übersprungen, deshalb lässt sich das jederzeit wiederholen."

#, php-format
msgid "Text of the attachment \"%s\""
msgstr "Text des Anhangs „%s“"

msgid "Copy the text of the attachments (PDF2Text)"
msgstr "Text der Anhänge übernehmen (PDF2Text)"

msgid "The text of PDF, Word and OpenDocument attachments that were not read yet is added as a followup."
msgstr "Der Text noch nicht gelesener PDF-, Word- und OpenDocument-Anhänge wird als Folgebeitrag hinzugefügt."

#, php-format
msgid "PDF2Text: %1$d followup(s) added, %2$d file(s) without text, %3$d file(s) not readable (see files/_log/pdf2text.log)."
msgstr "PDF2Text: %1$d Folgebeitrag/-beiträge hinzugefügt, %2$d Datei(en) ohne Text, %3$d Datei(en) nicht lesbar (siehe files/_log/pdf2text.log)."

msgid "Copy the text into a followup (PDF2Text)"
msgstr "Text als Folgebeitrag übernehmen (PDF2Text)"

msgid "Add again"
msgstr "Erneut hinzufügen"

msgid "The request failed. Please reload the page and try again."
msgstr "Die Anfrage ist fehlgeschlagen. Bitte die Seite neu laden und es noch einmal versuchen."

msgid "PDF2Text is switched off for this type."
msgstr "PDF2Text ist für diesen Typ ausgeschaltet."

msgid "You may not add a followup here."
msgstr "Hier dürfen Sie keinen Folgebeitrag hinzufügen."

msgid "The file was not found."
msgstr "Die Datei wurde nicht gefunden."

msgid "The text of this file was added before. Add it again?"
msgstr "Der Text dieser Datei wurde bereits übernommen. Erneut hinzufügen?"

msgid "The file contains no text (e.g. a scanned PDF)."
msgstr "Die Datei enthält keinen Text (z. B. ein gescanntes PDF)."

msgid "This file type is not read (see the settings of PDF2Text)."
msgstr "Dieser Dateityp wird nicht gelesen (siehe Einstellungen von PDF2Text)."

msgid "The file could not be read (see files/_log/pdf2text.log)."
msgstr "Die Datei konnte nicht gelesen werden (siehe files/_log/pdf2text.log)."

msgid "The text was added as a followup."
msgstr "Der Text wurde als Folgebeitrag hinzugefügt."
