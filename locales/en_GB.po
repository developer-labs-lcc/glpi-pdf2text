msgid "Run \"composer install --no-dev\" in the plugin directory first."
msgstr "Run \"composer install --no-dev\" in the plugin directory first."

#, php-format
msgid "Text of the PDF attachment \"%s\""
msgstr "Text of the PDF attachment \"%s\""

msgid "The text was shortened. The complete text is in the attachment."
msgstr "The text was shortened. The complete text is in the attachment."

msgid "The configuration was saved."
msgstr "The configuration was saved."

msgid "PDF2Text"
msgstr "PDF2Text"

msgid "PDF2Text – configuration"
msgstr "PDF2Text – configuration"

msgid "When a PDF is attached to a ticket, change or problem (by mail, form or API), its text is added as a followup, so it can be read and searched without opening the file. Scanned PDFs without a text layer are skipped."
msgstr "When a PDF is attached to a ticket, change or problem (by mail, form or API), its text is added as a followup, so it can be read and searched without opening the file. Scanned PDFs without a text layer are skipped."

msgid "Add the text to"
msgstr "Add the text to"

msgid "Private followup (only visible to technicians)"
msgstr "Private followup (only visible to technicians)"

msgid "Maximum length of the text (characters)"
msgstr "Maximum length of the text (characters)"

msgid "Path of pdftotext (optional)"
msgstr "Path of pdftotext (optional)"

msgid "Leave empty to search the usual places. Without pdftotext (package poppler-utils), the built-in PHP parser is used; pdftotext keeps tables and columns better."
msgstr "Leave empty to search the usual places. Without pdftotext (package poppler-utils), the built-in PHP parser is used; pdftotext keeps tables and columns better."

msgid "Method in use"
msgstr "Method in use"
