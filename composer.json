{
    "name": "developer-labs/glpi-pdf2text",
    "description": "PDF2Text – copies the text of PDF, Word and OpenDocument attachments into GLPI tickets, changes and problems (GLPI 11 and 12)",
    "type": "glpi-plugin",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "AI & Developer Labs LLC"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-mbstring": "*",
        "smalot/pdfparser": "^2.12"
    },
    "replace": {
        "symfony/polyfill-mbstring": "*"
    },
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "8.2.99"
        },
        "sort-packages": true,
        "prepend-autoloader": false
    },
    "autoload": {
        "psr-4": {
            "GlpiPlugin\\Pdf2text\\": "src/"
        }
    },
    "require-dev": {
        "thecodingmachine/safe": "^3.3"
    }
}
